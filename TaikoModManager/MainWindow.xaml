<Window x:Class="TaikoModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaikoModManager"
        Title="Taiko Mod Manager"
        Background="#131313"
        Foreground="#F2F2F2"
        Height="750"
        Width="1280"
        MinHeight="750"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#303030"
                                BorderBrush="#353535"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#115F58"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#115F58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#115F58"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#115F58"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#101010"/>
                                <Setter Property="Foreground" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Spacer"
                                Margin="0"
                                Padding="0"
                                MinHeight="52"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                            <Border x:Name="Tab"
                                    MinWidth="100"
                                    MinHeight="36"
                                    VerticalAlignment="Bottom"
                                    Background="#1D1D1D"
                                    CornerRadius="6,6,0,0"
                                    Cursor="Hand">
                                <ContentPresenter ContentSource="Header"
                                                  Margin="12,5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontFamily="Segoe UI"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.FontSize="15"
                                                  TextElement.Foreground="#F2F2F2"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#353535"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#353535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ManagerHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ManagerItem" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="row"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                Padding="0,2">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#146B64"/>
                                <Setter TargetName="row" Property="BorderBrush" Value="#49D8CB"/>
                                <Setter TargetName="row" Property="BorderThickness" Value="3,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#424242"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#353535"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#303030"/>
        </Style>
        <ControlTemplate x:Key="BrowseComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="toggleBorder" Background="#303030" BorderBrush="#424242" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#49D8CB"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#49D8CB"/>
                    <Setter TargetName="toggleBorder" Property="Background" Value="#353535"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="BrowseComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#115F58"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#146B64"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrowseComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="#424242"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource BrowseComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          Template="{StaticResource BrowseComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False">
                                <Grid>
                                    <ContentPresenter
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="#F2F2F2"
                                                      TextElement.FontWeight="Bold"/>
                                    <Path Data="M 0,0 L 10,0 L 5,5 Z"
                                          Fill="#F2F2F2"
                                          Width="10"
                                          Height="5"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,11,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="#303030"
                                        BorderBrush="#49D8CB"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollRepeatButton" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb" Background="#727272" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#9A9A9A"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#B0B0B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border x:Name="trackBackground" Background="#1A1A1A" CornerRadius="5">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DarkScrollRepeatButton}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DarkScrollRepeatButton}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="12"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="12"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="GameSelectorToggle" TargetType="ToggleButton">
            <Border x:Name="toggleBorder" Background="#303030" BorderBrush="#353535" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#115F58"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#115F58"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="GameSelector" TargetType="ComboBox">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource GameSelectorToggle}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Image Source="res/rhythm-festival-keyart-512.jpg" Stretch="UniformToFill"/>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border MinWidth="280" Background="#303030" BorderBrush="#353535" BorderThickness="1">
                                    <ScrollViewer Margin="4" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GameSelectorItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#115F58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Panel.ZIndex="3"
              Height="52"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Style="{StaticResource GameSelector}"
                          Width="40"
                          Height="40"
                          SelectedIndex="0"
                          Margin="0,0,8,0">
                    <ComboBoxItem Style="{StaticResource GameSelectorItem}" Height="52">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="res/rhythm-festival-keyart-512.jpg" Width="32" Height="32" Stretch="UniformToFill"/>
                            <TextBlock Grid.Column="1"
                                       Text="Taiko no Tatsujin: Rhythm Festival"
                                       Foreground="#F2F2F2"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </ComboBoxItem>
                </ComboBox>
                <Button Content="Mod Manager Config"
                        Height="40"
                        Padding="16,0"
                        Margin="0,0,8,0"
                        Click="OpenModManagerConfigButton_Click"/>
                <Button Content="Open Game Folder"
                        Height="40"
                        Padding="16,0"
                        Margin="0,0,8,0"
                        Click="OpenGameDirectoryButton_Click"/>
                <Button Content="Launch"
                        Height="40"
                        Padding="20,0"
                        Click="LaunchGameButton_Click"/>
            </StackPanel>
        </Grid>

        <TabControl Name="MainTabs"
                    SelectedIndex="1"
                    SelectionChanged="MainTabs_SelectionChanged"
                    Background="#202020"
                    BorderBrush="#353535">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="TekaTeka Mods" Foreground="#F2F2F2" FontWeight="Bold"/>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="1.6*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="TekaTeka Song Mods" Foreground="#F2F2F2" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Grid.Column="1" Content="Open Mods Folder" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="OpenModsFolderButton_Click"/>
                    <Button Grid.Column="2" Content="Create Mod" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="CreateModButton_Click"/>
                    <Button Grid.Column="3" Content="Check for Updates" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="CheckModsUpdatesButton_Click"/>
                    <Button Grid.Column="4" Content="Refresh" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="RefreshModsButton_Click"/>

                    <Grid Grid.Row="1" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="10,5,3,3" Background="#202020" BorderBrush="#424242" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Background="#303030">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Enabled" Foreground="#F2F2F2" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="SortModsByEnabled_Click"/>
                                    <TextBlock Grid.Column="1" Text="Name" Foreground="#F2F2F2" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0" Cursor="Hand" MouseLeftButtonUp="SortModsByName_Click"/>
                                </Grid>
                                <ListView Name="TekaTekaModsList" Grid.Row="1" Background="Transparent" BorderThickness="0" FontFamily="Segoe UI" FontSize="15" Foreground="#F2F2F2" ItemContainerStyle="{StaticResource ManagerItem}" SelectionChanged="ManagerList_SelectionChanged" PreviewMouseLeftButtonDown="ManagerList_PreviewMouseLeftButtonDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsModEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F2F2F2" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="10" Background="Transparent"/>
                        <Grid Grid.Column="2" Margin="3,3,10,3" DataContext="{Binding SelectedItem, ElementName=TekaTekaModsList}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.5*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#181818" BorderBrush="#424242" BorderThickness="1">
                                <Grid>
                                    <Image Source="res/app-icon.png" Opacity="0.12" Stretch="Uniform" Margin="30"/>
                                    <local:AnimatedPreviewImage SourceUrl="{Binding PreviewUrl}" Opacity="0.48" Stretch="Uniform"/>
                                    <Border Background="#78131313"/>
                                    <StackPanel VerticalAlignment="Bottom" Margin="18">
                                        <TextBlock Text="TEKATEKA MOD" FontSize="12" FontWeight="Bold" Foreground="#A0A0A0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Author, StringFormat=by {0}}" Foreground="#C0C0C0"/>
                                            <TextBlock Text="{Binding VersionDisplay, StringFormat=  •  {0}}" Foreground="#C0C0C0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Source, StringFormat=Downloaded from: {0}}" Foreground="#A0A0A0" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="0,5,0,0" Background="#202020" BorderBrush="#424242" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="{Binding Source, StringFormat=Source: {0}}" Foreground="#49D8CB" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#F2F2F2" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                    <GridSplitter Grid.Row="2" Grid.ColumnSpan="5" Height="10" Background="Transparent"/>
                    <TextBox Name="ConsoleLog"
                             Grid.Row="3"
                             Grid.ColumnSpan="5"
                             Margin="10,3,10,10"
                             Background="#202020"
                             BorderBrush="#424242"
                             BorderThickness="1"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Plugins" Foreground="#F2F2F2" FontWeight="Bold"/>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="1.6*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Installed Plugins" Foreground="#F2F2F2" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Grid.Column="1" Content="Install Plugin" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="InstallPluginButton_Click"/>
                    <Button Grid.Column="2" Content="Check for Updates" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="UpdatePluginsButton_Click"/>
                    <Button Grid.Column="3" Content="Open Plugins Folder" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="OpenPluginsFolderButton_Click"/>
                    <Button Grid.Column="4" Content="Refresh" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="RefreshPluginsButton_Click"/>

                    <Grid Grid.Row="1" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="10,5,3,3" Background="#202020" BorderBrush="#424242" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Background="#303030">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Enabled" Foreground="#F2F2F2" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="SortPluginsByEnabled_Click"/>
                                    <TextBlock Grid.Column="1" Text="Name" Foreground="#F2F2F2" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0" Cursor="Hand" MouseLeftButtonUp="SortPluginsByName_Click"/>
                                </Grid>
                                <ListView Name="PluginList" Grid.Row="1" Background="Transparent" BorderThickness="0" FontFamily="Segoe UI" FontSize="15" Foreground="#F2F2F2" ItemContainerStyle="{StaticResource ManagerItem}" SelectionChanged="ManagerList_SelectionChanged" PreviewMouseLeftButtonDown="ManagerList_PreviewMouseLeftButtonDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsPluginEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F2F2F2" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="10" Background="Transparent"/>
                        <Grid Grid.Column="2" Margin="3,3,10,3" DataContext="{Binding SelectedItem, ElementName=PluginList}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.5*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#181818" BorderBrush="#424242" BorderThickness="1">
                                <Grid>
                                    <Image Source="res/app-icon.png" Opacity="0.12" Stretch="Uniform" Margin="30"/>
                                    <local:AnimatedPreviewImage SourceUrl="{Binding PreviewUrl}" Opacity="0.48" Stretch="Uniform"/>
                                    <Border Background="#78131313"/>
                                    <StackPanel VerticalAlignment="Bottom" Margin="18">
                                        <TextBlock Text="PLUGIN" FontSize="12" FontWeight="Bold" Foreground="#A0A0A0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding VersionDisplay}" Foreground="#C0C0C0"/>
                                            <TextBlock Text="{Binding Author, StringFormat=  •  by {0}}" Foreground="#C0C0C0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Source, StringFormat=Downloaded from: {0}}" Foreground="#A0A0A0" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="0,5,0,0" Background="#202020" BorderBrush="#424242" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="{Binding Source, StringFormat=Source: {0}}" Foreground="#49D8CB" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#F2F2F2" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                    <GridSplitter Grid.Row="2" Grid.ColumnSpan="5" Height="10" Background="Transparent"/>
                    <TextBox Name="PluginConsoleLog"
                             Grid.Row="3"
                             Grid.ColumnSpan="5"
                             Margin="10,3,10,10"
                             Background="#202020"
                             BorderBrush="#424242"
                             BorderThickness="1"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Foreground="#F2F2F2"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Browse Mods" Foreground="#F2F2F2" FontWeight="Bold"/>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="245"/>
                        <ColumnDefinition Width="106"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="126"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Taiko Mod Archive" FontFamily="Segoe UI" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0"/>
                    <TextBox Name="BrowseSearchText" Grid.Column="1" Height="35" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Search Rhythm Festival PC mods"/>
                    <Button Grid.Column="2" Content="Search" Height="35" Margin="0,0,8,0" VerticalAlignment="Center" Click="BrowseSearchButton_Click"/>
                    <ComboBox Name="BrowseSortBox" Style="{StaticResource BrowseComboBox}" Grid.Column="3" Height="35" Margin="0,0,8,0" VerticalContentAlignment="Center" SelectionChanged="BrowseFilterChanged">
                        <ComboBoxItem Content="Latest" IsSelected="True"/>
                        <ComboBoxItem Content="Most Downloads"/>
                        <ComboBoxItem Content="Most Likes"/>
                    </ComboBox>
                    <ComboBox Name="BrowseTypeBox" Style="{StaticResource BrowseComboBox}" Grid.Column="4" Height="35" Margin="0,0,10,0" VerticalContentAlignment="Center" SelectionChanged="BrowseFilterChanged">
                        <ComboBoxItem Content="All Types" IsSelected="True"/>
                        <ComboBoxItem Content="Plugins"/>
                        <ComboBoxItem Content="Song Mods"/>
                    </ComboBox>
                    <Button Name="BrowseRefreshButton" Grid.Column="5" Content="Refresh" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="BrowseRefreshButton_Click"/>

                    <Grid Grid.Row="1" Grid.ColumnSpan="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="10,5,3,5" Background="#202020" BorderBrush="#424242" BorderThickness="1">
                            <ListView Name="BrowseModsList" Background="Transparent" BorderThickness="0" Foreground="#F2F2F2" FontFamily="Segoe UI" ItemContainerStyle="{StaticResource ManagerItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="78" Margin="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="62" Height="62" Background="#303030" BorderBrush="#424242" BorderThickness="1" VerticalAlignment="Center" ClipToBounds="True">
                                                <Viewbox Stretch="Uniform" StretchDirection="Both">
                                                    <Image Source="{Binding PreviewUrl}" Stretch="None"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="3,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="#49D8CB" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding AuthorName, StringFormat=  •  by {0}}" Foreground="#C0C0C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Stats}" Foreground="#A0A0A0" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="10" Background="Transparent"/>
                        <Grid Grid.Column="2" Margin="3,5,10,5" DataContext="{Binding SelectedItem, ElementName=BrowseModsList}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.05*" MinHeight="230"/>
                                <RowDefinition Height="1.25*"/>
                                <RowDefinition Height="46"/>
                            </Grid.RowDefinitions>
                            <Border Background="#181818" BorderBrush="#424242" BorderThickness="1">
                                <Grid ClipToBounds="True">
                                    <Viewbox Stretch="Uniform" StretchDirection="Both" Opacity="0.42">
                                        <local:AnimatedPreviewImage SourceUrl="{Binding PreviewUrl}" Stretch="None"/>
                                    </Viewbox>
                                    <Border Background="#990F0F0F"/>
                                    <StackPanel VerticalAlignment="Bottom" Margin="16">
                                        <TextBlock Text="{Binding TypeLabel}" Foreground="#49D8CB" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Name}" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AuthorName, StringFormat=by {0}}" Foreground="#C0C0C0" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Margin="0,5,0,5" Background="#202020" BorderBrush="#424242" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Padding="12"/>
                                </ScrollViewer>
                            </Border>
                            <Button Name="BrowseInstallButton" Grid.Row="2" Content="Install Selected Mod" Height="35" Margin="0,0,0,3" VerticalAlignment="Bottom" Click="BrowseInstallButton_Click"/>
                        </Grid>
                    </Grid>

                    <TextBlock Name="BrowseStatusText" Grid.Row="2" VerticalAlignment="Center" Margin="12,0" Foreground="#C0C0C0" Text="Rhythm Festival PC mods only"/>
                    <ProgressBar Name="BrowseDownloadProgress" Grid.Row="2" Grid.ColumnSpan="6" Width="240" Height="8" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Foreground="#49D8CB" Background="#303030" BorderBrush="#424242" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Name="BrowsePreviousButton" Content="Previous" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BrowsePreviousButton_Click"/>
                        <TextBlock Name="BrowsePageText" VerticalAlignment="Center" MinWidth="82" TextAlignment="Center" Text="Page 1"/>
                        <Button Name="BrowseNextButton" Content="Next" Height="32" Padding="16,0" Margin="8,0,0,0" Click="BrowseNextButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="BepInEx Config" Foreground="#F2F2F2" FontWeight="Bold"/>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BepInEx Configuration" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Grid.Column="1" Content="Save Changes" Height="35" Margin="0,0,10,0" VerticalAlignment="Center" Click="SaveConfigChanges"/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="10,5,10,10" Background="#202020" BorderBrush="#424242" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="ConfigOptionsPanel" Margin="10"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
